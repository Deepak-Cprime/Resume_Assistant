   "version": 1,
   "versionNonce": 401991736,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "ADAPTIVE CHUNK ALGO (run once after parsing all files)\nL       = token length of every section, all resumes\nmin_tok = clamp(p25(L), 64, 128)\nmax_tok = clamp(p90(L), 256, 512)   # also <= emb model limit\nfor each section:\n  len <= max_tok   -> 1 chunk (keep section whole)\n  else             -> split on job entries / bullets,\n                      overlap 10-15%\n  len <  min_tok   -> merge with neighbour section\nprefix: \"Candidate C12 | Role R3 | Section: Experience\"",
   "originalText": "ADAPTIVE CHUNK ALGO (run once after parsing all files)\nL       = token length of every section, all resumes\nmin_tok = clamp(p25(L), 64, 128)\nmax_tok = clamp(p90(L), 256, 512)   # also <= emb model limit\nfor each section:\n  len <= max_tok   -> 1 chunk (keep section whole)\n  else             -> split on job entries / bullets,\n                      overlap 10-15%\n  len <  min_tok   -> merge with neighbour section\nprefix: \"Candidate C12 | Role R3 | Section: Experience\"",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el35",
   "lineHeight": 1.25,
   "autoResize": true
  },
