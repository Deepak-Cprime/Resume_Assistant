   "updated": 1,
   "link": null,
   "locked": false,
   "text": "MODEL BY USE CASE  (use_case: resume in config)\nselects: section map, chunker params, prompt pack,\ndefault embedding (short, skill/keyword-dense text\n-> hybrid BM25 + dense matters more than big model)\nnew use case (e.g. contracts) = new profile, same code",
   "originalText": "MODEL BY USE CASE  (use_case: resume in config)\nselects: section map, chunker params, prompt pack,\ndefault embedding (short, skill/keyword-dense text\n-> hybrid BM25 + dense matters more than big model)\nnew use case (e.g. contracts) = new profile, same code",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el39",
   "lineHeight": 1.25,
   "autoResize": true
