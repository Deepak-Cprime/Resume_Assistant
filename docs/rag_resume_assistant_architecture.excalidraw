   "text": "# configs/config.yaml\nembedding:\n  provider: sentence_transformers   # -> openai\n  model: BAAI/bge-m3\nllm:\n  provider: ollama                  # -> anthropic\n  model: llama3.1:8b\nvector_store:\n  provider: faiss                   # -> pgvector\nchunking:\n  strategy: adaptive\n  min_tok: auto\n  max_tok: auto\nretrieval:\n  hybrid: true\n  top_k: 50\n  rerank_top_k: 15",
