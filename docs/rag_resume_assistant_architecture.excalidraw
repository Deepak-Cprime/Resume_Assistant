   "text": "Idempotent ingest:\nsha256(file) already indexed -> skip\nparse failures -> dead-letter list\n+ logged, never silently dropped",
   "originalText": "Idempotent ingest:\nsha256(file) already indexed -> skip\nparse failures -> dead-letter list\n+ logged, never silently dropped",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el33",
   "lineHeight": 1.25,
   "autoResize": true
  },
