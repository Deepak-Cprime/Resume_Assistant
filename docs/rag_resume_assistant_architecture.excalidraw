   "text": "Module layout\nsrc/\n  providers/   interfaces (ABC) + factory + impls\n  ingestion/   upload, parser, normalizer, metadata\n  chunking/    adaptive chunker, token stats\n  indexing/    embed + write vector/bm25/sqlite\n  retrieval/   query understanding, hybrid, rerank\n  generation/  context builder, prompts, guardrails\n  evaluation/  golden set, runner, metrics\n  api/  ui/    FastAPI routes, Streamlit app\nconfigs/  data/  tests/  docker-compose.yml",
   "originalText": "Module layout\nsrc/\n  providers/   interfaces (ABC) + factory + impls\n  ingestion/   upload, parser, normalizer, metadata\n  chunking/    adaptive chunker, token stats\n  indexing/    embed + write vector/bm25/sqlite\n  retrieval/   query understanding, hybrid, rerank\n  generation/  context builder, prompts, guardrails\n  evaluation/  golden set, runner, metrics\n  api/  ui/    FastAPI routes, Streamlit app\nconfigs/  data/  tests/  docker-compose.yml",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el122",
   "lineHeight": 1.25,
   "autoResize": true
