   "updated": 1,
   "link": null,
   "locked": false,
   "text": "FAISS vs Elasticsearch\nFAISS: vectors only, fast, local\n  -> metadata lives in SQLite\nES/OpenSearch: vectors + BM25 +\n  filters + full doc in ONE store\n  -> more context per hit (prod)",
   "originalText": "FAISS vs Elasticsearch\nFAISS: vectors only, fast, local\n  -> metadata lives in SQLite\nES/OpenSearch: vectors + BM25 +\n  filters + full doc in ONE store\n  -> more context per hit (prod)",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el41",
   "lineHeight": 1.25,
   "autoResize": true
