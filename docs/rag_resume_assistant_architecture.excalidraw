   "updated": 1,
   "link": null,
   "locked": false,
   "text": "FORMAT DECISION (multiple PDFs): better format than MD?\na) Markdown       keeps headings -> drives section split   <- chosen\nb) JSON/section   {section: text} sidecar from (a), feeds metadata DB\nc) direct vectorize raw text  -> fast, but loses structure,\n                                 mixes Skills+Experience in one chunk\n=> MD for chunking + JSON profile for filters (both stored)",
   "originalText": "FORMAT DECISION (multiple PDFs): better format than MD?\na) Markdown       keeps headings -> drives section split   <- chosen\nb) JSON/section   {section: text} sidecar from (a), feeds metadata DB\nc) direct vectorize raw text  -> fast, but loses structure,\n                                 mixes Skills+Experience in one chunk\n=> MD for chunking + JSON profile for filters (both stored)",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "el37",
   "lineHeight": 1.25,
   "autoResize": true
  },
